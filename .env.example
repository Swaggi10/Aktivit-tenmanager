# Database
DATABASE_URL="postgresql://taskmanager:taskmanager_password@localhost:5432/aktivitatenmanager?schema=public"

# JWT Secret (generieren Sie einen sicheren Wert für Produktion)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Microsoft Azure AD (OAuth)
# Siehe docs/AZURE_SETUP.md für Anleitung zur Einrichtung
AZURE_CLIENT_ID="your-azure-client-id"
AZURE_CLIENT_SECRET="your-azure-client-secret"
AZURE_TENANT_ID="your-azure-tenant-id"
AZURE_REDIRECT_URI="http://localhost:4000/auth/microsoft/callback"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Backend
PORT=4000
NODE_ENV=development

# CORS Origins (komma-separiert)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
